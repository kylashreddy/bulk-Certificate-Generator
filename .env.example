# Copy to .env and adjust. Every value shown is the default.

# SQLite works with zero setup. For Postgres (docker compose up db):
# DATABASE_URL=postgresql+psycopg://certgen:certgen@localhost:5432/certgen
DATABASE_URL=sqlite:///./certgen.db
STORAGE_DIR=./storage
RUN_MIGRATIONS_ON_STARTUP=true

# thread = background ThreadPoolExecutor; inline = synchronous (used by tests)
DISPATCHER=thread
WORKER_POOL_SIZE=4
PROCESSING_CHUNK_SIZE=50

MAX_RECIPIENTS_PER_JOB=5000
MAX_RENDER_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=0.5

# Printed into each certificate's QR code; must be reachable by whoever scans it.
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
